# Server Environment Configuration
ENVIRONMENT=development
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database & Supabase Credentials (SERVER-SIDE ONLY - NEVER EXPOSE TO FRONTEND)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campusfix_db
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google Gemini API Key (SERVER-SIDE ONLY - google-genai SDK)
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Candidate Search Radius (Meters)
CANDIDATE_SEARCH_RADIUS_METERS=50.0
